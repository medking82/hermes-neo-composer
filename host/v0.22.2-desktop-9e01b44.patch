diff --git a/apps/desktop/src/app/chat/composer/input-row.tsx b/apps/desktop/src/app/chat/composer/input-row.tsx
new file mode 100644
index 0000000000..aa2ec21647
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/input-row.tsx
@@ -0,0 +1,44 @@
+import type { ReactNode } from 'react'
+
+import { Slot as ContribSlot } from '@/contrib/react/slot'
+import { cn } from '@/lib/utils'
+
+import { COMPOSER_AREAS } from './contrib'
+
+export function ComposerInputRow({
+  stacked,
+  contextMenu,
+  input,
+  controls
+}: {
+  stacked: boolean
+  contextMenu: ReactNode
+  input: ReactNode
+  controls: ReactNode
+}) {
+  return (
+    <div
+      className={cn(
+        'grid w-full',
+        stacked
+          ? 'grid-cols-[auto_1fr] gap-(--composer-row-gap) [grid-template-areas:"input_input"_"menu_controls"]'
+          : 'grid-cols-[auto_1fr_auto] items-center gap-(--composer-control-gap) [grid-template-areas:"menu_input_controls"]'
+      )}
+    >
+      <div className="flex translate-y-[3px] items-start gap-(--composer-control-gap) self-start [grid-area:menu]">
+        {contextMenu}
+        <ContribSlot area={COMPOSER_AREAS.leading} />
+      </div>
+      <div className="min-w-0 [grid-area:input]">{input}</div>
+      {/* `justify-end` packs contributed actions and the send cluster
+                      together on the right. The cluster must not carry its own
+                      `ml-auto`: in the stacked layout the auto margin absorbs the
+                      row's free space and pins a contributed action to the row
+                      start, detached from the cluster (#116332). */}
+      <div className="flex min-w-0 items-center justify-end gap-(--composer-control-gap) [grid-area:controls]">
+        <ContribSlot area={COMPOSER_AREAS.actions} />
+        {controls}
+      </div>
+    </div>
+  )
+}
diff --git a/apps/desktop/src/app/chat/composer/next-prompt-keys.test.tsx b/apps/desktop/src/app/chat/composer/next-prompt-keys.test.tsx
new file mode 100644
index 0000000000..04f9e219cd
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/next-prompt-keys.test.tsx
@@ -0,0 +1,115 @@
+import { AssistantRuntimeProvider, type ThreadMessageLike, useExternalStoreRuntime } from '@assistant-ui/react'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+import { clearSessionDraft, mainComposerScope } from '@/store/composer'
+import { clearQueuedPrompts } from '@/store/composer-queue'
+
+import { RICH_INPUT_SLOT } from './rich-editor'
+import type { ChatBarProps, ChatBarState } from './types'
+
+const suggestion = vi.hoisted(() => ({
+  text: '运行解析器回归测试',
+  decide: vi.fn(() => '运行解析器回归测试'),
+  refresh: vi.fn()
+}))
+
+vi.mock('./hooks/use-composer-behavior', () => ({ useComposerBehavior: () => suggestion }))
+import { ChatBar } from './index'
+const SESSION = 'next-prompt-key-test'
+
+const state: ChatBarState = {
+  model: { canSwitch: false, model: '', provider: '' },
+  tools: { enabled: false, label: '' },
+  voice: { enabled: false, active: false }
+}
+
+function Harness({ onSubmit }: { onSubmit: ChatBarProps['onSubmit'] }) {
+  const runtime = useExternalStoreRuntime({
+    convertMessage: (m: ThreadMessageLike) => m,
+    isRunning: false,
+    messages: [] as ThreadMessageLike[],
+    onNew: async () => {}
+  })
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <MemoryRouter>
+        <I18nProvider configClient={null} initialLocale="en">
+          <ChatBar
+            busy={false}
+            disabled={false}
+            gateway={null}
+            onCancel={vi.fn()}
+            onSubmit={onSubmit}
+            sessionId={SESSION}
+            state={state}
+          />
+        </I18nProvider>
+      </MemoryRouter>
+    </AssistantRuntimeProvider>
+  )
+}
+
+const open = () => {
+  const submit = vi.fn<ChatBarProps['onSubmit']>(async () => true)
+  const view = render(<Harness onSubmit={submit} />)
+  const editor = view.container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+  editor.tabIndex = 0
+  editor.focus()
+
+  return { editor, submit }
+}
+
+afterEach(() => {
+  cleanup()
+  mainComposerScope.clear()
+  clearSessionDraft(SESSION)
+  clearQueuedPrompts(SESSION)
+  vi.clearAllMocks()
+})
+
+describe('native next-prompt key ownership', () => {
+  it('keeps ghost text outside draft; Tab accepts, then Enter sends', async () => {
+    const { editor, submit } = open()
+    expect(editor.textContent).toBe('')
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Enter' })
+    })
+    expect(submit).not.toHaveBeenCalled()
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Tab' })
+    })
+    expect(editor.textContent).toBe(suggestion.text)
+    expect(submit).not.toHaveBeenCalled()
+    expect(suggestion.decide).toHaveBeenCalledWith('consumed')
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Enter' })
+    })
+    expect(submit).toHaveBeenCalledWith(suggestion.text, expect.anything())
+  })
+  it('does not overwrite a live keystroke before React has synchronized', async () => {
+    const { editor } = open()
+    editor.textContent = '我自己的输入'
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Tab' })
+    })
+    expect(editor.textContent).toBe('我自己的输入')
+    expect(suggestion.decide).not.toHaveBeenCalled()
+  })
+  it('yields to composition and Shift+Tab; Esc dismisses without stopping', async () => {
+    const { editor, submit } = open()
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Tab', isComposing: true })
+      fireEvent.keyDown(editor, { key: 'Tab', shiftKey: true })
+    })
+    expect(suggestion.decide).not.toHaveBeenCalled()
+    await act(async () => {
+      fireEvent.keyDown(editor, { key: 'Escape' })
+    })
+    expect(suggestion.decide).toHaveBeenCalledWith('dismissed')
+    expect(submit).not.toHaveBeenCalled()
+  })
+})
