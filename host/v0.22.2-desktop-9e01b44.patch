@@ -0,0 +1,154 @@
+import { cleanup } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { actRender, Harness, type HarnessHandle, RUNTIME_SESSION_ID } from './prompt-actions-harness'
+
+vi.mock('@/hermes', () => ({
+  getLatestSessionMessages: vi.fn(async () => ({ messages: [], session_id: 'session' })),
+  getProfiles: vi.fn(async () => ({ profiles: [] })),
+  getSession: vi.fn(),
+  PROMPT_SUBMIT_REQUEST_TIMEOUT_MS: 1_800_000,
+  setApiRequestProfile: vi.fn(),
+  transcribeAudio: vi.fn()
+}))
+
+vi.mock('@/store/gateway', async importOriginal => ({
+  ...(await importOriginal<Record<string, unknown>>()),
+  requestGatewayForAgent: vi.fn()
+}))
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+})
+
+describe('strict composer steering RPC', () => {
+  it.each(['read-failure', 'stage-failure', 'owner-changed', 'invalid-ref'])(
+    'does not steer or fall back after %s during image staging',
+    async failure => {
+      let current = true
+      vi.stubGlobal('hermesDesktop', {
+        readFileDataUrl: vi.fn(async () => {
+          if (failure === 'read-failure') {
+            throw new Error('Original image unavailable')
+          }
+          return 'data:image/png;base64,Zml4dHVyZQ=='
+        })
+      })
+      const requestGateway = vi.fn(async (_method: string) => {
+        if (failure === 'stage-failure') {
+          throw new Error('Stage refused')
+        }
+        if (failure === 'owner-changed') {
+          current = false
+        }
+        return { image_ref: failure === 'invalid-ref' ? 'invalid' : 'b'.repeat(32) } as never
+      })
+      let handle: HarnessHandle | null = null
+      await actRender(
+        <Harness onReady={h => (handle = h)} refreshSessions={async () => undefined} requestGateway={requestGateway} />
+      )
+      const attachments = [{ id: 'image-one', kind: 'image' as const, path: '/fixture.png', label: 'fixture.png' }]
+      expect(
+        await handle!.steerPrompt('inspect', 'steer', 'a'.repeat(32), {
+          attachments,
+          isCurrent: () => current
+        })
+      ).toBe(false)
+      expect(requestGateway.mock.calls.every(call => call[0] === 'session.steer_image_stage')).toBe(true)
+      expect(attachments).toHaveLength(1)
+    }
+  )
+
+  it('stages original image bytes only for the captured session, then steers opaque references', async () => {
+    const readFileDataUrl = vi.fn(async () => 'data:image/png;base64,Zml4dHVyZQ==')
+    vi.stubGlobal('hermesDesktop', { readFileDataUrl })
+    const requestGateway = vi.fn(async (method: string) =>
+      method === 'session.steer_image_stage'
+        ? ({ image_ref: 'b'.repeat(32), media_type: 'image/png', bytes: 7 } as never)
+        : ({ status: 'steered' } as never)
+    )
+    let handle: HarnessHandle | null = null
+    await actRender(
+      <Harness onReady={h => (handle = h)} refreshSessions={async () => undefined} requestGateway={requestGateway} />
+    )
+    const images = {
+      attachments: [
+        {
+          id: 'image-one',
+          occurrenceId: 'one',
+          kind: 'image' as const,
+          path: '/client-only.png',
+          label: 'image.png',
+          thumbnailUrl: 'data:image/png;base64,dGh1bWI='
+        }
+      ],
+      isCurrent: () => true
+    }
+    expect(await handle!.steerPrompt('inspect', 'steer', 'a'.repeat(32), images)).toBe(true)
+    expect(readFileDataUrl).toHaveBeenCalledWith('/client-only.png')
+    expect(requestGateway.mock.calls).toEqual([
+      ['session.steer_image_stage', { session_id: RUNTIME_SESSION_ID, content_base64: 'Zml4dHVyZQ==' }],
+      [
+        'session.steer',
+        {
+          session_id: RUNTIME_SESSION_ID,
+          text: 'inspect',
+          strict: true,
+          steer_id: 'a'.repeat(32),
+          image_refs: ['b'.repeat(32)]
+        }
+      ]
+    ])
+  })
+
+  it('sends explicit composer steering through session.steer without an interrupt bubble', async () => {
+    const requestGateway = vi.fn(async () => ({ status: 'steered' }) as never)
+    let handle: HarnessHandle | null = null
+    const capturedStates: Record<string, unknown>[] = []
+    await actRender(
+      <Harness
+        onReady={h => (handle = h)}
+        onSeedState={state => capturedStates.push(state)}
+        refreshSessions={async () => undefined}
+        requestGateway={requestGateway}
+      />
+    )
+
+    expect(await handle!.steerPrompt('  steer safely  ', 'steer', 'a'.repeat(32))).toBe(true)
+    expect(requestGateway).toHaveBeenCalledWith('session.steer', {
+      session_id: RUNTIME_SESSION_ID,
+      text: 'steer safely',
+      strict: true,
+      steer_id: 'a'.repeat(32)
+    })
+    expect(requestGateway).not.toHaveBeenCalledWith('session.redirect', expect.anything())
+    expect(capturedStates).toEqual([])
+  })
+
+  it.each(['queued', 'rejected', 'missing'])(
+    'strict steering refuses %s without recovery or fallback RPC',
+    async status => {
+      const requestGateway = vi.fn(async () => {
+        if (status === 'missing') {
+          throw new Error('session not found')
+        }
+
+        return { status } as never
+      })
+
+      let handle: HarnessHandle | null = null
+      await actRender(
+        <Harness onReady={h => (handle = h)} refreshSessions={async () => undefined} requestGateway={requestGateway} />
+      )
+      expect(await handle!.steerPrompt('retain me', 'steer', 'a'.repeat(32))).toBe(false)
+      expect(requestGateway).toHaveBeenCalledExactlyOnceWith('session.steer', {
+        session_id: RUNTIME_SESSION_ID,
+        text: 'retain me',
+        strict: true,
+        steer_id: 'a'.repeat(32)
+      })
+    }
+  )
+})
