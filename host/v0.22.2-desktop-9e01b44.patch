diff --git a/apps/desktop/src/lib/strict-steering.test.ts b/apps/desktop/src/lib/strict-steering.test.ts
new file mode 100644
index 0000000000..4d445525a4
--- /dev/null
+++ b/apps/desktop/src/lib/strict-steering.test.ts
@@ -0,0 +1,213 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import type { HermesGateway } from '@/hermes'
+
+import { strictSteerDelivery } from './strict-steering'
+
+function source() {
+  const listeners = new Set<(event: any) => void>()
+  const states = new Set<(state: any) => void>()
+
+  const gateway = {
+    onEvent: (fn: (event: any) => void) => {
+      listeners.add(fn)
+
+      return () => listeners.delete(fn)
+    },
+    onState: (fn: (state: any) => void) => {
+      states.add(fn)
+      fn('open')
+
+      return () => states.delete(fn)
+    }
+  } as unknown as HermesGateway
+
+  return {
+    gateway,
+    listeners,
+    states,
+    emit: (event: any) => {
+      for (const fn of listeners) {
+        fn(event)
+      }
+    }
+  }
+}
+
+describe('strict safe-boundary receipts', () => {
+  it('requires the staged image batch, not merely a matching steer ID', async () => {
+    const s = source()
+    let id = ''
+    let refs: readonly string[] | undefined
+    const done = vi.fn()
+    const pending = strictSteerDelivery(
+      s.gateway,
+      's',
+      value => {
+        id = value
+        refs = ['b'.repeat(32)]
+        return true
+      },
+      new AbortController().signal,
+      () => refs
+    )
+    void pending.then(done)
+    for (const image_refs of [undefined, ['c'.repeat(32)]]) {
+      s.emit({
+        type: 'steer.delivery',
+        session_id: 's',
+        payload: {
+          steer_id: id,
+          delivered: true,
+          image_refs,
+          image_delivery: 'reference_injected'
+        }
+      })
+    }
+    await Promise.resolve()
+    expect(done).not.toHaveBeenCalled()
+    s.emit({
+      type: 'steer.delivery',
+      session_id: 's',
+      payload: {
+        steer_id: id,
+        delivered: true,
+        image_refs: refs,
+        image_delivery: 'reference_injected'
+      }
+    })
+    expect(await pending).toBe(true)
+  })
+
+  it.each([undefined, ['b'.repeat(32)], ['c'.repeat(32)]])(
+    'settles a matching explicit image rejection without awaiting turn end: %j',
+    async imageRefs => {
+      const s = source()
+      const controller = new AbortController()
+      const done = vi.fn()
+      let id = ''
+      const pending = strictSteerDelivery(
+        s.gateway,
+        's',
+        value => {
+          id = value
+          return true
+        },
+        controller.signal,
+        () => ['b'.repeat(32)]
+      )
+      void pending.then(done)
+      try {
+        for (const [session_id, steer_id] of [
+          ['other', id],
+          ['s', 'wrong']
+        ]) {
+          s.emit({
+            type: 'steer.delivery',
+            session_id,
+            payload: { steer_id, delivered: true, image_delivery: 'rejected' }
+          })
+        }
+        await Promise.resolve()
+        expect(done).not.toHaveBeenCalled()
+        s.emit({
+          type: 'steer.delivery',
+          session_id: 's',
+          payload: { steer_id: id, delivered: true, image_delivery: 'rejected', image_refs: imageRefs }
+        })
+        await Promise.resolve()
+        expect(done).toHaveBeenCalledExactlyOnceWith(false)
+        expect(await pending).toBe(false)
+        expect(s.listeners.size + s.states.size).toBe(0)
+      } finally {
+        controller.abort()
+      }
+    }
+  )
+
+  it('does not resolve on ACK; a matching injection resolves and cleans up', async () => {
+    const s = source()
+    let id = ''
+    const done = vi.fn()
+
+    const p = strictSteerDelivery(
+      s.gateway,
+      's',
+      value => {
+        id = value
+
+        return true
+      },
+      new AbortController().signal
+    )
+
+    void p.then(done)
+    await Promise.resolve()
+    expect(done).not.toHaveBeenCalled()
+    s.emit({ type: 'steer.delivery', session_id: 'other', payload: { steer_id: id, delivered: true } })
