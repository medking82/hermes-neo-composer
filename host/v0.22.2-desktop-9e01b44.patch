@@ -0,0 +1,35 @@
+import { canStrictSteerAttachments, type StrictSteerImages } from '@/lib/strict-steering'
+
+import { type GatewayRequest, readImageForRemoteAttach } from './utils'
+
+/** Never use ordinary attach, recovery or a thumbnail as the original image. */
+export async function stageStrictSteerImages(
+  request: GatewayRequest,
+  sessionId: string,
+  images: StrictSteerImages
+): Promise<string[]> {
+  if (!canStrictSteerAttachments(images.attachments) || !images.isCurrent()) {
+    throw new Error('Image Steering owner or attachment changed')
+  }
+
+  const refs: string[] = []
+  for (const image of images.attachments) {
+    if (!images.isCurrent()) {
+      throw new Error('Image Steering owner changed')
+    }
+    const data = await readImageForRemoteAttach(image.path!)
+    if (!data || data.contentBase64.length > 4 * Math.ceil((10 * 1024 * 1024) / 3) || !images.isCurrent()) {
+      throw new Error('Original Steering image unavailable or too large')
+    }
+    const staged = await request<{ image_ref: string }>('session.steer_image_stage', {
+      session_id: sessionId,
+      content_base64: data.contentBase64
+    })
+    if (!/^[a-f0-9]{32}$/.test(staged?.image_ref ?? '') || !images.isCurrent()) {
+      throw new Error('Image staging not confirmed for the current owner')
+    }
+    refs.push(staged.image_ref)
+  }
+  images.onStaged?.(refs)
+  return refs
+}
