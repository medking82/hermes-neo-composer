index 0000000000..a544ad50a6
--- /dev/null
+++ b/apps/desktop/src/lib/strict-steering.ts
@@ -0,0 +1,135 @@
+import type { HermesGateway } from '@/hermes'
+import type { ComposerAttachment } from '@/store/composer'
+
+export interface StrictSteerImages {
+  attachments: readonly ComposerAttachment[]
+  isCurrent: () => boolean
+  onStaged?: (refs: readonly string[]) => void
+}
+
+export function canStrictSteerAttachments(attachments: readonly ComposerAttachment[]): boolean {
+  return (
+    attachments.length <= 4 &&
+    attachments.every(
+      image => image.kind === 'image' && !!image.id && !!image.path && !image.attachedSessionId && !image.uploadState
+    )
+  )
+}
+
+export function sameSteerAttachments(
+  current: readonly ComposerAttachment[],
+  submitted: readonly ComposerAttachment[]
+): boolean {
+  return (
+    current.length === submitted.length &&
+    current.every((image, index) => {
+      const expected = submitted[index]
+      return expected.occurrenceId
+        ? image.id === expected.id && image.occurrenceId === expected.occurrenceId && image.path === expected.path
+        : image === expected
+    })
+  )
+}
+
+/** The subscription is installed before send: a tool boundary can beat the RPC ACK.
+ * Unknown/closed transports fail closed; no automatic retry, queue, or redirect. */
+export function strictSteerDelivery(
+  gateway: HermesGateway | null | undefined,
+  sessionId: string | null | undefined,
+  send: (id: string) => Promise<boolean> | boolean,
+  signal: AbortSignal,
+  imageRefs?: () => readonly string[] | undefined
+): Promise<boolean> {
+  if (!gateway?.onEvent || !gateway.onState || !sessionId || signal.aborted) {
+    return Promise.resolve(false)
+  }
+  const steerId = crypto.randomUUID().replaceAll('-', '')
+
+  return new Promise(resolve => {
+    let settled = false
+    const disposers: (() => void)[] = []
+
+    const finish = (delivered: boolean) => {
+      if (settled) {
+        return
+      }
+      settled = true
+
+      for (const off of disposers) {
+        off()
+      }
+      signal.removeEventListener('abort', aborted)
+      resolve(delivered)
+    }
+
+    const aborted = () => finish(false)
+    disposers.push(
+      gateway.onEvent(event => {
+        if (event.session_id !== sessionId) {
+          return
+        }
+        const payload = event.payload as
+          | {
+              steer_id?: string
+              delivered?: boolean
+              running?: boolean
+              image_refs?: string[]
+              image_delivery?: string
+            }
+          | undefined
+
+        if (event.type === 'steer.delivery' && payload?.steer_id === steerId) {
+          if (imageRefs && payload.image_delivery === 'rejected') {
+            finish(false)
+            return
+          }
+          if (payload.delivered === true && imageRefs) {
+            const expected = imageRefs()
+            if (
+              !expected?.length ||
+              payload.image_delivery !== 'reference_injected' ||
+              !Array.isArray(payload.image_refs) ||
+              payload.image_refs.length !== expected.length ||
+              !expected.every((ref, index) => payload.image_refs![index] === ref)
+            ) {
+              return
+            }
+          }
+          finish(payload.delivered === true)
+        }
+
+        if (event.type === 'session.info' && payload?.running === false) {
+          finish(false)
+        }
+      })
+    )
+
+    const offState = gateway.onState(state => {
+      if (state !== 'open') {
+        finish(false)
+      }
+    })
+
+    if (settled) {
+      offState()
+
+      return
+    }
+
+    disposers.push(offState)
+    signal.addEventListener('abort', aborted, { once: true })
+
+    // Invoke synchronously to freeze the owner before another UI action can run.
+    try {
+      void Promise.resolve(send(steerId))
+        .then(accepted => {
+          if (!accepted) {
+            finish(false)
+          }
+        })
+        .catch(() => finish(false))
+    } catch {
+      finish(false)
+    }
+  })
+}
