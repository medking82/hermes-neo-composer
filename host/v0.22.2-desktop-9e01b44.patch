@@ -0,0 +1,54 @@
+import { useStore } from '@nanostores/react'
+
+import { $currentReasoningEffortWire } from '@/store/session'
+
+import { $activeComposerRevision, getActiveComposer, type markActiveComposer } from '../focus'
+import { useComposerVisible } from '../visibility'
+
+import { useComposerBehavior } from './use-composer-behavior'
+
+type Options = Omit<Parameters<typeof useComposerBehavior>[0], 'enabled' | 'revision'> & {
+  modelRevision: string
+  placeholder: string
+}
+interface Eligibility {
+  target: Parameters<typeof markActiveComposer>[0]
+  inputDisabled: boolean
+  awaitingInput: boolean
+  blockingPrompt: unknown
+  cardWaiting: boolean
+  queueEdit: unknown
+  queuedCount: number
+  trigger: unknown
+}
+
+function inputProps(text: string | null, placeholder: string) {
+  return {
+    'data-next-prompt': text ? 'ready' : undefined,
+    'data-placeholder': text || placeholder,
+    title: text ? `${text} · Tab` : undefined
+  }
+}
+
+export function useComposerNextPrompt(options: Options, eligibility: Eligibility) {
+  const visible = useComposerVisible()
+  useStore($activeComposerRevision)
+  const reasoning = useStore($currentReasoningEffortWire)
+
+  const nextPrompt = useComposerBehavior({
+    ...options,
+    revision: `${options.modelRevision}:${reasoning}`,
+    enabled:
+      visible &&
+      getActiveComposer() === eligibility.target &&
+      !eligibility.inputDisabled &&
+      !eligibility.awaitingInput &&
+      !eligibility.blockingPrompt &&
+      !eligibility.cardWaiting &&
+      !eligibility.queueEdit &&
+      eligibility.queuedCount === 0 &&
+      !eligibility.trigger
+  })
+
+  return { ...nextPrompt, inputProps: inputProps(nextPrompt.text, options.placeholder) }
+}
