+import type { MouseEventHandler } from 'react'
+
 import { Button } from '@/components/ui/button'
 import { useI18n } from '@/i18n'
+import { cn } from '@/lib/utils'
+
+import { COMPOSER_FADE_BACKGROUND } from './composer-utils'
+
+/** Decorative backing and the native pop-out grab region; no draft ownership. */
+export function ComposerSurfaceChrome({
+  poppedOut,
+  popoutAllowed,
+  dragging,
+  onToggle
+}: {
+  poppedOut: boolean
+  popoutAllowed: boolean
+  dragging: boolean
+  onToggle: MouseEventHandler<HTMLDivElement>
+}) {
+  return (
+    <>
+      {!poppedOut && (
+        <div
+          className="pointer-events-none absolute inset-0 rounded-[inherit]"
+          style={{ background: COMPOSER_FADE_BACKGROUND }}
+        />
+      )}
+      {/* Only the exposed ring receives the grab cursor and diagonal hatch;
+          the raised surface covers its input and controls. */}
+      {popoutAllowed && (
+        <div
+          aria-hidden
+          className={cn('pointer-events-auto absolute inset-0', dragging ? 'cursor-grabbing' : 'cursor-grab')}
+          data-dragging={dragging ? '' : undefined}
+          data-slot="composer-drag-region"
+          onDoubleClick={onToggle}
+        />
+      )}
+    </>
+  )
+}
 
