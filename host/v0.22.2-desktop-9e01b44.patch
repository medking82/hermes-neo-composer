@@ -0,0 +1,56 @@
+import { Button } from '@/components/ui/button'
+import { KbdCombo } from '@/components/ui/kbd'
+import { useI18n } from '@/i18n'
+
+export function ComposerSteerHint({ canSteer, hasPayload }: { canSteer: boolean; hasPayload: boolean }) {
+  const { t } = useI18n()
+
+  if (!canSteer || !hasPayload) {
+    return null
+  }
+
+  return (
+    <div
+      className="flex items-center justify-end gap-1 text-[0.68rem] leading-none text-muted-foreground/70"
+      data-slot="composer-steer-hint"
+    >
+      <KbdCombo combo="mod+enter" size="sm" />
+      <span>{t.composer.steerKeyHint}</span>
+    </div>
+  )
+}
+
+export function ComposerQueueEditNotice({
+  edit,
+  prompt,
+  onExit
+}: {
+  edit: unknown
+  prompt: unknown
+  onExit: (mode: 'cancel' | 'save') => void
+}) {
+  const { t } = useI18n()
+
+  if (!edit || !prompt) {
+    return null
+  }
+
+  return (
+    <div className="flex items-center justify-between gap-2 rounded-lg border border-[color-mix(in_srgb,var(--dt-composer-ring)_32%,transparent)] bg-accent/18 px-2 py-1">
+      <div className="min-w-0 text-[0.7rem] text-muted-foreground/88">{t.composer.editingQueuedInComposer}</div>
+      <div className="flex shrink-0 items-center gap-1">
+        <Button
+          className="h-6 rounded-md px-2 text-[0.68rem]"
+          onClick={() => onExit('cancel')}
+          type="button"
+          variant="ghost"
+        >
+          {t.common.cancel}
+        </Button>
+        <Button className="h-6 rounded-md px-2 text-[0.68rem]" onClick={() => onExit('save')} type="button">
+          {t.common.save}
+        </Button>
+      </div>
+    </div>
+  )
+}
diff --git a/apps/desktop/src/app/chat/composer/busy-enter-keys.test.tsx b/apps/desktop/src/app/chat/composer/busy-enter-keys.test.tsx
new file mode 100644
index 0000000000..bbf8879482
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/busy-enter-keys.test.tsx
@@ -0,0 +1,453 @@
+import { AssistantRuntimeProvider, type ThreadMessageLike, useExternalStoreRuntime } from '@assistant-ui/react'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { registry } from '@/contrib/registry'
+import { I18nProvider } from '@/i18n'
+import { clearSessionDraft, mainComposerScope } from '@/store/composer'
+import { clearQueuedPrompts, getQueuedPrompts } from '@/store/composer-queue'
+import { $notifications } from '@/store/notifications'
+
+import { markActiveComposer } from './focus'
+import { RICH_INPUT_SLOT } from './rich-editor'
+import type { ChatBarProps, ChatBarState } from './types'
+
+import { ChatBar } from './index'
+
+vi.mock('@/app/session/hooks/use-busy-input-mode', () => ({ useBusyInputMode: () => 'interrupt' }))
+
+const SESSION = 'test-busy-enter-keys'
+const deliveryListeners = new Set<(event: any) => void>()
+
+const deliveryGateway = {
+  onEvent: (fn: (event: any) => void) => {
+    deliveryListeners.add(fn)
+
+    return () => deliveryListeners.delete(fn)
+  },
+  onState: (fn: (state: string) => void) => {
+    fn('open')
+
+    return () => {}
+  }
+}
+
+async function deliverSteer(id: string, delivered = true, imageRefs?: string[]) {
+  await act(async () => {
+    for (const fn of deliveryListeners) {
+      fn({
+        type: 'steer.delivery',
+        session_id: SESSION,
+        payload: {
+          steer_id: id,
+          delivered,
+          ...(imageRefs ? { image_refs: imageRefs, image_delivery: 'reference_injected' } : {})
+        }
+      })
+    }
+  })
+}
+
+let removeBehavior = () => {}
+beforeEach(() => {
+  removeBehavior = registry.register({
+    id: 'busy-key-fixture',
+    source: 'plugin:neo-next-prompt',
+    area: 'composer.behavior.v2',
+    data: {
+      protocol: 2,
+      create: () => ({}),
+      keyAction: (e: {
+        key: string
+        busy: boolean
+        ctrlKey?: boolean
+        metaKey?: boolean
+        altKey?: boolean
+        shiftKey?: boolean
+      }) =>
+        e.key === 'Enter' && e.busy && !e.shiftKey && !e.altKey
+          ? e.ctrlKey || e.metaKey
+            ? 'steer'
+            : 'queue'
+          : undefined
+    }
+  })
+})
+afterEach(() => removeBehavior())
+
+const state: ChatBarState = {
+  model: { canSwitch: false, model: '', provider: '' },
+  tools: { enabled: false, label: '' },
+  voice: { enabled: false, active: false }
+}
+
+function Harness(props: Partial<ChatBarProps>) {
+  const runtime = useExternalStoreRuntime({
+    convertMessage: (message: ThreadMessageLike) => message,
+    isRunning: props.busy ?? false,
+    messages: [] as ThreadMessageLike[],
+    onNew: async () => {}
+  })
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <MemoryRouter>
+        <I18nProvider configClient={null} initialLocale="en">
+          <ChatBar
+            busy={true}
+            disabled={false}
+            gateway={deliveryGateway as never}
+            onCancel={vi.fn()}
+            onSubmit={vi.fn(async () => true)}
+            sessionId={SESSION}
+            state={state}
+            {...props}
+          />
+        </I18nProvider>
+      </MemoryRouter>
+    </AssistantRuntimeProvider>
+  )
+}
+
+function openComposer(props: Partial<ChatBarProps> = {}) {
+  const { container } = render(<Harness {...props} />)
+  const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+  editor.tabIndex = 0
+
+  return editor
+}
+
+async function pressEnter(editor: HTMLElement, text: string, modifiers: KeyboardEventInit & { keyCode?: number } = {}) {
+  await act(async () => {
+    editor.focus()
+    // Deliberately omit input: the real handler must use the latest DOM text,
+    // even when a fast keystroke precedes the composer state's next render.
+    editor.textContent = text
+    fireEvent.keyDown(editor, { key: 'Enter', ...modifiers })
+  })
+}
+
+afterEach(() => {
+  cleanup()
+  mainComposerScope.clear()
+  clearSessionDraft(SESSION)
+  clearQueuedPrompts(SESSION)
+})
+
+describe('busy composer Enter preference', () => {
+  it('preserves the native explicit Steer button in interrupt mode when the plugin is disabled', async () => {
+    removeBehavior()
+    const onSteer = vi.fn(async () => true)
+    const editor = openComposer({ onSteer })
+    await act(async () => {
+      editor.focus()
+      editor.textContent = 'native toolbar guidance'
+      fireEvent.input(editor)
+    })
+    const button = await screen.findByRole('button', { name: 'Steer the current run' })
+    await act(async () => {
+      fireEvent.click(button)
+    })
+    expect(onSteer).toHaveBeenCalledExactlyOnceWith('native toolbar guidance', 'steer')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('restores the native Enter interrupt-mode action when the plugin is disabled', async () => {
+    removeBehavior()
+    const onSteer = vi.fn(async () => true)
+    const editor = openComposer({ onSteer })
+    await pressEnter(editor, 'native steering')
+    expect(onSteer).toHaveBeenCalledExactlyOnceWith('native steering', 'interrupt')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+  it.each([{ ctrlKey: true }, { metaKey: true }])(
+    'preserves busy native mod+Enter queueing after plugin removal: %j',
+    async modifiers => {
+      removeBehavior()
+      const onSteer = vi.fn(async () => true)
+      const onSubmit = vi.fn(async () => true)
+      const editor = openComposer({ onSteer, onSubmit })
+      await pressEnter(editor, 'native queued follow-up', modifiers)
+      expect(getQueuedPrompts(SESSION).map(entry => entry.text)).toEqual(['native queued follow-up'])
+      expect(onSteer).not.toHaveBeenCalled()
+      expect(onSubmit).not.toHaveBeenCalled()
+    }
+  )
+
+  it('queues plain Enter without steering or stopping the running turn', async () => {
+    const onSteer = vi.fn(async () => true)
+    const onCancel = vi.fn()
+    const editor = openComposer({ onSteer, onCancel })
+
+    await pressEnter(editor, 'follow up later')
+
+    expect(getQueuedPrompts(SESSION).map(entry => entry.text)).toEqual(['follow up later'])
+    expect(onSteer).not.toHaveBeenCalled()
+    expect(onCancel).not.toHaveBeenCalled()
+  })
+
+  it('uses Ctrl+Enter to steer the running turn instead of queueing', async () => {
+    const onSteer = vi.fn(async () => true)
+    const editor = openComposer({ onSteer })
+
+    await pressEnter(editor, 'correct this now', { ctrlKey: true })
+
+    expect(onSteer).toHaveBeenCalledExactlyOnceWith(
+      'correct this now',
+      'steer',
+      expect.stringMatching(/^[a-f0-9]{32}$/)
+    )
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it.each(['reject', 'throw'])('retains the strict draft without queueing on %s', async outcome => {
+    $notifications.set([])
+
+    const onSteer = vi.fn(async () => {
+      if (outcome === 'throw') {
+        throw new Error('connection unavailable')
+      }
+
+      return false
+    })
+
+    const onCancel = vi.fn()
+    const onSubmit = vi.fn(async () => true)
+    const editor = openComposer({ onSteer, onCancel, onSubmit })
+    await pressEnter(editor, 'keep this guidance', { ctrlKey: true })
+    expect(editor.textContent).toBe('keep this guidance')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+    expect(onCancel).not.toHaveBeenCalled()
+    expect(onSubmit).not.toHaveBeenCalled()
+    expect($notifications.get().at(-1)?.message).toContain('draft is kept')
+  })
+
+  it('keeps the draft after acceptance until a safe-boundary delivery receipt', async () => {
+    const editor = openComposer({ onSteer: vi.fn(async () => true) })
+    await pressEnter(editor, 'wait for actual injection', { ctrlKey: true })
+    expect(editor.textContent).toBe('wait for actual injection')
+  })
+
+  it('distinguishes a Steering ACK from the next-turn queue', async () => {
+    $notifications.set([])
+    const onSteer = vi.fn(async (..._args: unknown[]) => true)
+    const editor = openComposer({ onSteer })
+    await pressEnter(editor, 'guidance', { ctrlKey: true })
+    await deliverSteer(onSteer.mock.calls[0][2] as string)
+    expect(editor.textContent).toBe('')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+    expect($notifications.get().find(item => item.kind === 'success')?.message).toContain(
+      'not queued for the next turn'
+    )
+  })
+
+  it('keeps newer typing and deduplicates Ctrl+Enter while awaiting the ACK', async () => {
+    let resolve!: (value: boolean) => void
+
+    const onSteer = vi.fn(
+      (..._args: unknown[]) =>
+        new Promise<boolean>(done => {
+          resolve = done
+        })
+    )
+
+    const editor = openComposer({ onSteer })
+    await pressEnter(editor, 'original guidance', { ctrlKey: true })
+    expect(editor.textContent).toBe('original guidance')
+    await pressEnter(editor, 'newer draft', { ctrlKey: true })
+    expect(onSteer).toHaveBeenCalledTimes(1)
+    await act(async () => {
+      resolve(true)
+    })
+    await deliverSteer(onSteer.mock.calls[0][2] as string)
+    expect(editor.textContent).toBe('newer draft')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('refuses slash commands on strict Ctrl+Enter without native command dispatch', async () => {
+    const onSteer = vi.fn(async () => true)
+    const onSubmit = vi.fn(async () => true)
+    const onCancel = vi.fn()
+    const editor = openComposer({ onSteer, onSubmit, onCancel })
+    await pressEnter(editor, '/stop', { ctrlKey: true })
+    expect(editor.textContent).toBe('/stop')
+    expect(onSteer).not.toHaveBeenCalled()
+    expect(onSubmit).not.toHaveBeenCalled()
+    expect(onCancel).not.toHaveBeenCalled()
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('keeps image thumbnails and text until the matching strict delivery', async () => {
+    $notifications.set([])
+    const onSteer = vi.fn<NonNullable<ChatBarProps['onSteer']>>(async (_text, _mode, _id, images) => {
+      images?.onStaged?.(['b'.repeat(32)])
+      return true
+    })
+    const editor = openComposer({ onSteer })
+    const image = {
+      id: 'image-one',
+      occurrenceId: 'image-occurrence-one',
+      label: 'fixture.png',
+      path: '/fixture.png',
+      kind: 'image' as const,
+      thumbnailUrl: 'data:image/png;base64,Zml4dHVyZQ=='
+    }
+    await act(async () => {
+      mainComposerScope.$attachments.set([image])
+    })
+    await pressEnter(editor, 'inspect this screenshot', { ctrlKey: true })
+    expect(onSteer).toHaveBeenCalledWith(
+      'inspect this screenshot',
+      'steer',
+      expect.any(String),
+      expect.objectContaining({ attachments: [image], isCurrent: expect.any(Function) })
+    )
+    expect(editor.textContent).toBe('inspect this screenshot')
+    expect(mainComposerScope.$attachments.get()).toEqual([image])
+    await deliverSteer('wrong-receipt')
+    expect(mainComposerScope.$attachments.get()).toEqual([image])
+    await deliverSteer(onSteer.mock.calls[0][2] as string)
+    expect(mainComposerScope.$attachments.get()).toEqual([image])
+    await deliverSteer(onSteer.mock.calls[0][2] as string, true, ['b'.repeat(32)])
+    expect(editor.textContent).toBe('')
+    expect(mainComposerScope.$attachments.get()).toEqual([])
+    expect($notifications.get().find(item => item.kind === 'success')?.message).toContain(
+      'image inspection unconfirmed'
+    )
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('refuses malformed attachments on strict Ctrl+Enter and retains both draft and attachment', async () => {
+    const onSteer = vi.fn(async () => true)
+    const editor = openComposer({ onSteer })
+    await act(async () => {
+      mainComposerScope.$attachments.set([{ name: 'fixture.png', path: '/fixture.png', kind: 'image' } as never])
+    })
+    await pressEnter(editor, 'image guidance', { ctrlKey: true })
+    expect(editor.textContent).toBe('image guidance')
+    expect(mainComposerScope.$attachments.get()).toHaveLength(1)
+    expect(onSteer).not.toHaveBeenCalled()
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('shows the Ctrl+Enter steer hint while steerable with a payload', async () => {
+    const onSteer = vi.fn(async () => true)
+    const view = render(<Harness onSteer={onSteer} />)
+    const editor = view.container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+    editor.tabIndex = 0
+
+    await act(async () => {
+      editor.focus()
+      editor.textContent = 'draft text'
+      fireEvent.input(editor)
+      await new Promise<void>(resolve => window.requestAnimationFrame(() => resolve()))
+    })
+
+    expect(view.container.querySelector('[data-slot="composer-steer-hint"]')).toBeTruthy()
+  })
+
+  it('hides the steer hint when idle', async () => {
+    const view = render(<Harness busy={false} />)
+    const editor = view.container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+    editor.tabIndex = 0
+
+    await act(async () => {
+      editor.focus()
+      editor.textContent = 'draft text'
+      fireEvent.input(editor)
+      await new Promise<void>(resolve => window.requestAnimationFrame(() => resolve()))
+    })
+
+    expect(view.container.querySelector('[data-slot="composer-steer-hint"]')).toBeNull()
+  })
+
+  it('still sends plain Enter immediately while idle', async () => {
+    const onSubmit = vi.fn<ChatBarProps['onSubmit']>(async () => true)
+    const editor = openComposer({ busy: false, onSubmit })
+
+    await pressEnter(editor, 'send while idle')
+
+    expect(onSubmit).toHaveBeenCalledTimes(1)
+    expect(onSubmit.mock.calls[0]?.[0]).toBe('send while idle')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+
+  it('does not deliver the queue or stop on a second empty Enter', async () => {
+    const onSteer = vi.fn(async () => true)
+    const onCancel = vi.fn()
+    const editor = openComposer({ onSteer, onCancel })
+
+    await pressEnter(editor, 'wait for the current turn')
+    await pressEnter(editor, '')
+
+    expect(getQueuedPrompts(SESSION).map(entry => entry.text)).toEqual(['wait for the current turn'])
+    expect(onSteer).not.toHaveBeenCalled()
+    expect(onCancel).not.toHaveBeenCalled()
+  })
+
+  it.each([
+    { busy: false, shiftKey: true },
+    { busy: true, shiftKey: true },
+    { busy: true, isComposing: true },
+    { busy: true, keyCode: 229 },
+    { busy: true, disabled: true },
+    { busy: true, disabled: true, ctrlKey: true },
+    { busy: false, ctrlKey: true }
+  ])('does not send or queue for protected input %j', async ({ busy, disabled, ...modifiers }) => {
+    const onSteer = vi.fn(async () => true)
+    const onSubmit = vi.fn(async () => true)
+    const editor = openComposer({ busy, disabled, onSteer, onSubmit })
+
+    await pressEnter(editor, 'keep this draft', modifiers)
+
+    expect(onSteer).not.toHaveBeenCalled()
+    expect(onSubmit).not.toHaveBeenCalled()
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+    expect(editor.textContent).toBe('keep this draft')
+  })
+
+  it('keeps slash commands on their normal immediate path', async () => {
+    const onSubmit = vi.fn<ChatBarProps['onSubmit']>(async () => true)
+    const editor = openComposer({ onSubmit })
+
+    await pressEnter(editor, '/status')
+
+    expect(onSubmit).toHaveBeenCalledTimes(1)
+    expect(onSubmit.mock.calls[0]?.[0]).toBe('/status')
+    expect(getQueuedPrompts(SESSION)).toEqual([])
+  })
+})
+
+it('focus alone activates an inactive composer suggestion', async () => {
+  removeBehavior()
+  markActiveComposer('tile:other')
+  removeBehavior = registry.register({
+    id: 'focus-fixture',
+    source: 'plugin:neo-next-prompt',
+    area: 'composer.behavior.v2',
+    data: {
+      protocol: 2,
+      create: (env: { publish: (text: string | null) => void }) => ({
+        update: (state: { enabled: boolean; empty: boolean }) =>
+          env.publish(state.enabled && state.empty ? 'focus candidate' : null),
+        refresh: () => {},
+        decide: () => null,
+        dispose: () => {}
+      })
+    }
+  })
+  const gateway = { onEvent: () => () => {} } as never
+  const view = render(<Harness busy={false} gateway={gateway} />)
+  const editor = view.container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+  await act(async () => {
+    markActiveComposer('tile:other')
+    view.rerender(<Harness busy={false} gateway={gateway} state={{ ...state }} />)
+  })
+  expect(editor.getAttribute('data-next-prompt')).toBeNull()
+  await act(async () => {
+    fireEvent.focus(editor)
+  })
+  expect(editor.getAttribute('data-next-prompt')).toBe('ready')
+  markActiveComposer('main')
+})
