+import { afterEach, describe, expect, it } from 'vitest'
+
+import { registry } from '@/contrib/registry'
+
+import { behaviorKeyAction, behaviorKeys, behaviorRequestPath, composerBehavior, notifyBehaviorLifecycle } from './composer-behavior'
+const off: (()=>void)[]=[]
+const add=(data: unknown,source='plugin:neo-next-prompt')=>off.push(registry.register({id:`test-${off.length}`,source,area:'composer.behavior.v2',data}))
+afterEach(()=>{while(off.length){off.pop()?.()}})
+describe('minimal composer bridge contract',()=>{
+ it('uses native behavior when absent, wrong protocol, ambiguous or provider throws',()=>{
+  expect(composerBehavior()).toBeUndefined()
+  add({protocol:3,create:()=>({})});expect(composerBehavior()).toBeUndefined()
+  add({protocol:2,create:()=>({}),keyAction:()=>{throw Error('fixture')}})
+  expect(behaviorKeyAction({key:'Enter',busy:true})).toBeUndefined()
+  add({protocol:2,create:()=>({})});expect(composerBehavior()).toBeUndefined()
+ })
+ it('routes only validated actions and read-only key labels',()=>{
+  add({protocol:2,create:()=>({}),keyAction:()=> 'queue',readOnlyKeys:{'composer.queue':['enter']}})
+  expect(behaviorKeyAction({key:'Enter',busy:true})).toBe('queue')
+  expect(behaviorKeys('composer.queue',['mod+enter'])).toEqual(['enter'])
+ })
+ it('binds REST namespace to registry provenance and rejects escape/query paths',()=>{
+  expect(behaviorRequestPath('plugin:neo-next-prompt','/suggestion')).toBe('/api/plugins/neo-next-prompt/suggestion')
+
+  for(const path of ['/../config','/%2e%2e/config','/suggestion?profile=other','https://example.invalid']){expect(()=>behaviorRequestPath('plugin:neo-next-prompt',path)).toThrow()}
+  expect(()=>behaviorRequestPath('core','/suggestion')).toThrow()
+ })
+ it('delivers profile cleanup to the plugin instead of owning its storage',()=>{
+  const events:unknown[]=[];add({protocol:2,create:()=>({}),lifecycle:(event:unknown)=>events.push(event)})
+  notifyBehaviorLifecycle({kind:'drop',profile:'default',connectionId:'ga401'})
+  expect(events).toEqual([{kind:'drop',profile:'default',connectionId:'ga401'}])
+ })
+})
diff --git a/apps/desktop/src/store/composer-behavior.ts b/apps/desktop/src/store/composer-behavior.ts
new file mode 100644
index 0000000000..894fa26f17
--- /dev/null
+++ b/apps/desktop/src/store/composer-behavior.ts
@@ -0,0 +1,76 @@
+import { registry } from '@/contrib/registry'
+import type { Contribution } from '@/contrib/types'
+
+export const COMPOSER_BEHAVIOR_VERSION = 2
+export const COMPOSER_BEHAVIOR_AREA = 'composer.behavior.v2'
+export interface BehaviorContext {
+  connectionId: string
+  profile: string
+  sessionId: string
+  storedId: string
+  busy: boolean
+}
+export interface BehaviorKey {
+  key: string
+  busy: boolean
+  ctrlKey?: boolean
+  metaKey?: boolean
+  altKey?: boolean
+  shiftKey?: boolean
+}
+export type BehaviorLifecycle = { kind: 'drop'; profile: string; connectionId: string } | { kind: 'rename'; from: string; to: string }
+export interface BehaviorController {
+  update: (state: { enabled: boolean; empty: boolean }) => void
+  decide: (status: 'consumed' | 'dismissed') => null | string
+  refresh: () => void
+  dispose: () => void
+}
+export interface BehaviorEnvironment {
+  context: BehaviorContext
+  publish: (text: null | string) => void
+  request: <T>(path: string, body: unknown) => Promise<T>
+  onSettled: (listener: () => void) => () => void
+}
+export interface ComposerBehavior {
+  protocol: 2
+  create: (environment: BehaviorEnvironment) => BehaviorController
+  keyAction?: (event: BehaviorKey) => 'queue' | 'steer' | undefined
+  readOnlyKeys?: Record<string, readonly string[]>
+  lifecycle?: (event: BehaviorLifecycle) => void
+}
+
+export function composerBehavior(contributions: readonly Contribution[] = registry.getArea(COMPOSER_BEHAVIOR_AREA)) {
+  const providers = contributions.filter(item => {
+    const data = item.data as Partial<ComposerBehavior> | undefined
+
+    return /^plugin:[a-z0-9][a-z0-9_-]*$/.test(item.source || '') && data?.protocol === 2 && typeof data.create === 'function'
+  })
+
+  return providers.length === 1 ? providers[0] as typeof providers[number] & { data: ComposerBehavior } : undefined
+}
+
+export function behaviorRequestPath(source: string, path: string): string {
+  if (!/^plugin:[a-z0-9][a-z0-9_-]*$/.test(source) || !/^\/[a-zA-Z][a-zA-Z0-9_-]*$/.test(path)) {
+    throw new Error('Invalid composer extension namespace/path')
+  }
+
+  return `/api/plugins/${source.slice(7)}${path}`
+}
+
+export function behaviorKeyAction(event: BehaviorKey): 'queue' | 'steer' | undefined {
+  try {
+    const result = composerBehavior()?.data.keyAction?.(event)
+
+    return result === 'queue' || result === 'steer' ? result : undefined
+  } catch { return undefined }
+}
+
+export function behaviorKeys(id: string, fallback: readonly string[]): readonly string[] {
+  const keys = composerBehavior()?.data.readOnlyKeys?.[id]
+
+  return Array.isArray(keys) && keys.length > 0 && keys.every(key => typeof key === 'string') ? keys : fallback
+}
+
+export function notifyBehaviorLifecycle(event: BehaviorLifecycle): void {
+  try { composerBehavior()?.data.lifecycle?.(event) } catch { /* A plugin cannot break native profile operations. */ }
+}
