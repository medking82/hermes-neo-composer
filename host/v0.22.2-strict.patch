+import { act, cleanup, renderHook, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { registry } from '@/contrib/registry'
+
+import { useComposerBehavior } from './use-composer-behavior'
+const api = vi.hoisted(() => vi.fn())
+vi.mock('@/api/client', () => ({
+  hermesApiAs: api,
+  resolveOwnerNow: ({ profile }: { profile?: string }) => ({ connectionId: 'ga401', profile: profile || 'default' })
+}))
+
+let dispose = () => {}
+
+const options = {
+  gateway: {},
+  profile: 'default',
+  sessionId: 'runtime',
+  storedId: 'stored',
+  busy: false,
+  enabled: true,
+  empty: true,
+  revision: 'model:high'
+}
+
+const install = (protocol = 2) => {
+  dispose = registry.register({
+    id: 'native-bridge-test',
+    source: 'plugin:neo-next-prompt',
+    area: 'composer.behavior.v2',
+    data: {
+      protocol,
+      create: (env: any) => {
+        let started = false
+
+        return {
+          update: (s: any) => {
+            if (s.enabled && s.empty && !started) {
+              started = true
+              void env.request('/suggestion', {}).then((r: any) => env.publish(r.text))
+            }
+          },
+          decide: () => '运行回归测试',
+          refresh: () => {},
+          dispose: () => {}
+        }
+      }
+    }
+  })
+}
+
+beforeEach(() => {
+  api.mockReset()
+  api.mockResolvedValue({ text: '运行回归测试' })
+  install()
+})
+afterEach(() => {
+  cleanup()
+  dispose()
+})
+describe('scoped plugin composer host', () => {
+  it('captures profile/connection and inserts no text automatically', async () => {
+    const v = renderHook(p => useComposerBehavior(p), { initialProps: options })
+    await waitFor(() => expect(v.result.current.text).toBe('运行回归测试'))
+    expect(api.mock.calls[0][0]).toEqual({ connectionId: 'ga401', profile: 'default' })
+    expect(api.mock.calls[0][1].path).toBe('/api/plugins/neo-next-prompt/suggestion')
+    v.rerender({ ...options, empty: false })
+    expect(v.result.current.text).toBeNull()
+    v.rerender(options)
+    expect(api).toHaveBeenCalledTimes(1)
+  })
+  it('drops an old scope result after changing profile', async () => {
+    let finish: (r: unknown) => void = () => {}
+    api.mockImplementationOnce(
+      () =>
+        new Promise(r => {
+          finish = r
+        })
+    )
+    const v = renderHook(p => useComposerBehavior(p), { initialProps: options })
+    v.rerender({ ...options, profile: 'other' })
+    await waitFor(() => expect(v.result.current.text).toBe('运行回归测试'))
+    await act(async () => finish({ text: '旧会话建议' }))
+    expect(v.result.current.text).toBe('运行回归测试')
+    expect(api.mock.calls[1][0].profile).toBe('other')
+  })
+  it('does not execute an incompatible provider or publish unsafe text', async () => {
+    dispose()
+    install(3)
+    const bad = renderHook(() => useComposerBehavior(options))
+    expect(api).not.toHaveBeenCalled()
+    expect(bad.result.current.text).toBeNull()
+    bad.unmount()
+    dispose()
+    install()
+    api.mockResolvedValue({ text: 'ab\u202ecd' })
+    const v = renderHook(() => useComposerBehavior(options))
+    await waitFor(() => expect(api).toHaveBeenCalledTimes(1))
+    expect(v.result.current.text).toBeNull()
+  })
+})
diff --git a/apps/desktop/src/app/chat/composer/hooks/use-composer-behavior.ts b/apps/desktop/src/app/chat/composer/hooks/use-composer-behavior.ts
new file mode 100644
index 0000000000..a224061990
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/hooks/use-composer-behavior.ts
@@ -0,0 +1,194 @@
+import { useEffect, useMemo, useState } from 'react'
+
+import { hermesApiAs, resolveOwnerNow } from '@/api/client'
+import { useContributions } from '@/contrib/react/use-contributions'
+import {
+  type BehaviorController,
+  behaviorRequestPath,
+  COMPOSER_BEHAVIOR_AREA,
+  composerBehavior
+} from '@/store/composer-behavior'
+
+interface Options {
+  gateway: unknown
+  profile?: null | string
+  sessionId?: null | string
+  storedId?: null | string
+  busy: boolean
+  enabled: boolean
+  empty: boolean
+  revision: string
+}
+
+const validText = (text: unknown): text is string =>
+  typeof text === 'string' &&
+  text.trim() === text &&
+  text.length > 0 &&
+  Array.from(text).length <= 240 &&
+  !/[\p{Cc}\p{Cf}\u2028\u2029]/u.test(text)
+
+export function useComposerBehavior({
+  gateway,
+  profile,
+  sessionId,
+  storedId,
+  busy,
+  enabled,
+  empty,
+  revision
+}: Options) {
+  const contributions = useContributions(COMPOSER_BEHAVIOR_AREA)
+  const provider = useMemo(() => composerBehavior(contributions), [contributions])
+  const { connectionId, profile: resolvedProfile } = resolveOwnerNow({ profile })
+
+  const scope = useMemo(
+    () => ({
+      owner: { connectionId, profile: resolvedProfile },
+      gateway,
+      sessionId: sessionId || '',
+      storedId: storedId || sessionId || '',
+      busy,
+      revision
+    }),
+    [gateway, connectionId, resolvedProfile, sessionId, storedId, busy, revision]
+  )
+
+  // This is an owned controller lifetime, not a mirror of reactive app state.
+  const binding = useMemo(() => ({ scope, provider, controller: null as BehaviorController | null }), [scope, provider])
+  const [value, setValue] = useState<{ binding: typeof binding; text: string } | null>(null)
+
+  useEffect(() => {
+    if (!provider || !scope.gateway) {
+      return
+    }
+
+    let disposed = false
+    const subscriptions = new Set<() => void>()
+
+    const source = scope.gateway as {
+      onEvent?: (
+        fn: (event: { type: string; session_id?: string; payload?: { running?: boolean } }) => void
+      ) => () => void
+    }
+
+    try {
+      const controller = provider.data.create({
+        context: {
+          connectionId: scope.owner.connectionId || 'local',
+          profile: scope.owner.profile || 'default',
+          sessionId: scope.sessionId,
+          storedId: scope.storedId,
+          busy: scope.busy
+        },
+        publish: text => {
+          if (!disposed) {
+            setValue(validText(text) ? { binding, text } : null)
+          }
+        },
+        request: <T>(path: string, body: unknown) => {
+          if (disposed) {
+            return Promise.reject(new Error('Composer scope disposed'))
+          }
+
+          return hermesApiAs<T>(scope.owner, {
+            path: behaviorRequestPath(provider.source || '', path),
+            method: 'POST',
+            body,
+            timeoutMs: 32_000,
+            priority: undefined
+          })
+        },
+        onSettled: listener => {
+          const off =
+            source.onEvent?.(event => {
+              if (
+                !disposed &&
+                event.type === 'session.info' &&
+                event.session_id === scope.sessionId &&
+                event.payload?.running === false
+              ) {
+                listener()
+              }
+            }) || (() => {})
+
+          subscriptions.add(off)
+
+          return () => {
+            subscriptions.delete(off)
+            off()
+          }
+        }
+      })
+
+      if (
+        !controller ||
+        !['update', 'decide', 'refresh', 'dispose'].every(
+          key => typeof controller[key as keyof BehaviorController] === 'function'
+        )
+      ) {
+        throw new Error('Invalid composer controller')
+      }
+
+      binding.controller = controller
+    } catch {
+      disposed = true
+      setValue(null)
+
+      for (const off of subscriptions) {
+        off()
+      }
+
+      subscriptions.clear()
+    }
+
+    return () => {
+      disposed = true
+
+      try {
+        binding.controller?.dispose()
+      } catch {
+        /* Extension cleanup cannot break native input. */
+      }
+
+      binding.controller = null
+
+      for (const off of subscriptions) {
+        off()
+      }
+    }
+  }, [binding, scope, provider])
+
+  useEffect(() => {
+    try {
+      binding.controller?.update({ enabled, empty })
+    } catch {
+      setValue(null)
+    }
+  }, [binding, enabled, empty])
+
+  const text = value?.binding === binding && enabled && empty && !busy ? value.text : null
+
+  return {
+    text,
+    decide: (status: 'consumed' | 'dismissed'): null | string => {
+      if (!text || !binding.controller) {
+        return null
+      }
+
+      try {
+        const result = binding.controller.decide(status)
+
+        return result === text ? result : null
+      } catch {
+        return null
+      }
+    },
+    refresh: () => {
+      try {
+        binding.controller?.refresh()
+      } catch {
+        /* Optional extension only. */
+      }
+    }
+  }
+}
diff --git a/apps/desktop/src/app/chat/composer/hooks/use-composer-next-prompt.ts b/apps/desktop/src/app/chat/composer/hooks/use-composer-next-prompt.ts
