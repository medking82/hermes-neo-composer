@@ -0,0 +1,119 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import type { HermesGateway } from '@/hermes'
+
+import { strictSteerDelivery } from './strict-steering'
+
+function source() {
+  const listeners = new Set<(event: any) => void>()
+  const states = new Set<(state: any) => void>()
+
+  const gateway = {
+    onEvent: (fn: (event: any) => void) => {
+      listeners.add(fn)
+
+      return () => listeners.delete(fn)
+    },
+    onState: (fn: (state: any) => void) => {
+      states.add(fn)
+      fn('open')
+
+      return () => states.delete(fn)
+    }
+  } as unknown as HermesGateway
+
+  return {
+    gateway,
+    listeners,
+    states,
+    emit: (event: any) => {
+      for (const fn of listeners) {fn(event)}
+    }
+  }
+}
+
+describe('strict safe-boundary receipts', () => {
+  it('does not resolve on ACK; a matching injection resolves and cleans up', async () => {
+    const s = source()
+    let id = ''
+    const done = vi.fn()
+
+    const p = strictSteerDelivery(
+      s.gateway,
+      's',
+      value => {
+        id = value
+
+        return true
+      },
+      new AbortController().signal
+    )
+
+    void p.then(done)
+    await Promise.resolve()
+    expect(done).not.toHaveBeenCalled()
+    s.emit({ type: 'steer.delivery', session_id: 'other', payload: { steer_id: id, delivered: true } })
+    s.emit({ type: 'steer.delivery', session_id: 's', payload: { steer_id: 'wrong', delivered: true } })
+    await Promise.resolve()
+    expect(done).not.toHaveBeenCalled()
+    s.emit({ type: 'steer.delivery', session_id: 's', payload: { steer_id: id, delivered: true } })
+    expect(await p).toBe(true)
+    expect(s.listeners.size + s.states.size).toBe(0)
+  })
+
+  it('accepts an injection receipt that beats the ACK', async () => {
+    const s = source()
+    let ack!: (value: boolean) => void
+
+    const p = strictSteerDelivery(
+      s.gateway,
+      's',
+      id => {
+        s.emit({ type: 'steer.delivery', session_id: 's', payload: { steer_id: id, delivered: true } })
+
+        return new Promise<boolean>(resolve => {
+          ack = resolve
+        })
+      },
+      new AbortController().signal
+    )
+
+    expect(await p).toBe(true)
+    ack(false)
+    expect(s.listeners.size + s.states.size).toBe(0)
+  })
+
+  it.each(['rejected', 'settled', 'disconnected', 'aborted'])(
+    'retains the draft on %s (caller owns it)',
+    async reason => {
+      const s = source()
+      const controller = new AbortController()
+      let id = ''
+
+      const p = strictSteerDelivery(
+        s.gateway,
+        's',
+        value => {
+          id = value
+
+          return true
+        },
+        controller.signal
+      )
+
+      const actions: Record<string, () => void> = {
+        rejected: () =>
+          s.emit({ type: 'steer.delivery', session_id: 's', payload: { steer_id: id, delivered: false } }),
+        settled: () => s.emit({ type: 'session.info', session_id: 's', payload: { running: false } }),
+        disconnected: () => {
+          for (const fn of s.states) {fn('connecting')}
+        },
+        aborted: () => controller.abort()
+      }
+
+      actions[reason]()
+      expect(await p).toBe(false)
+      expect(s.listeners.size + s.states.size).toBe(0)
+    }
+  )
+})
diff --git a/apps/desktop/src/lib/strict-steering.ts b/apps/desktop/src/lib/strict-steering.ts
new file mode 100644
index 0000000000..a746185136
--- /dev/null
+++ b/apps/desktop/src/lib/strict-steering.ts
@@ -0,0 +1,63 @@
+import type { HermesGateway } from '@/hermes'
+
+/** The subscription is installed before send: a tool boundary can beat the RPC ACK.
+ * Unknown/closed transports fail closed; no automatic retry, queue, or redirect. */
+export function strictSteerDelivery(
+  gateway: HermesGateway | null | undefined,
+  sessionId: string | null | undefined,
+  send: (id: string) => Promise<boolean> | boolean,
+  signal: AbortSignal
+): Promise<boolean> {
+  if (!gateway?.onEvent || !gateway.onState || !sessionId || signal.aborted) {return Promise.resolve(false)}
+  const steerId = crypto.randomUUID().replaceAll('-', '')
+
+  return new Promise(resolve => {
+    let settled = false
+    const disposers: (() => void)[] = []
+
+    const finish = (delivered: boolean) => {
+      if (settled) {return}
+      settled = true
+
+      for (const off of disposers) {off()}
+      signal.removeEventListener('abort', aborted)
+      resolve(delivered)
+    }
+
+    const aborted = () => finish(false)
+    disposers.push(
+      gateway.onEvent(event => {
+        if (event.session_id !== sessionId) {return}
+        const payload = event.payload as { steer_id?: string; delivered?: boolean; running?: boolean } | undefined
+
+        if (event.type === 'steer.delivery' && payload?.steer_id === steerId) {finish(payload.delivered === true)}
+
+        if (event.type === 'session.info' && payload?.running === false) {finish(false)}
+      })
+    )
+
+    const offState = gateway.onState(state => {
+      if (state !== 'open') {finish(false)}
+    })
+
+    if (settled) {
+      offState()
+
+      return
+    }
+
+    disposers.push(offState)
+    signal.addEventListener('abort', aborted, { once: true })
+
+    // Invoke synchronously to freeze the owner before another UI action can run.
+    try {
+      void Promise.resolve(send(steerId))
+        .then(accepted => {
+          if (!accepted) {finish(false)}
+        })
+        .catch(() => finish(false))
+    } catch {
+      finish(false)
+    }
+  })
+}
