+"""Strict steering never demotes to the next-turn queue or interrupts."""
+import threading
+from types import SimpleNamespace
+from unittest.mock import ANY, Mock
+
+import pytest
+
+from tui_gateway import server
+
+
+@pytest.fixture
+def session(monkeypatch):
+    agent = SimpleNamespace(steer=Mock(return_value=True), steer_strict=Mock(return_value=True), redirect=Mock(), interrupt=Mock())
+    value = {"agent": agent, "running": True, "session_key": "strict-fixture",
+             "history_lock": threading.Lock(), "history": [], "history_version": 0,
+             "transport": None, "attached_images": []}
+    monkeypatch.setitem(server._sessions, "strict-fixture", value)
+    monkeypatch.setattr(server, "_session_compression_in_flight", lambda _: False)
+    return value
+
+
+def steer():
+    return server.handle_request({"id": "strict", "method": "session.steer",
+                                  "params": {"session_id": "strict-fixture", "text": "guidance", "strict": True, "steer_id": "a" * 32}})
+
+
+def test_strict_ack_is_distinct_from_next_turn_queue(session):
+    response = steer()
+    assert response.get("result", {}).get("status") == "steered", response
+    session["agent"].steer_strict.assert_called_once_with("guidance", ANY)
+    session["agent"].redirect.assert_not_called()
+    session["agent"].interrupt.assert_not_called()
+    assert not session.get("queued_prompt")
+
+
+@pytest.mark.parametrize("delivered", [True, False])
+def test_strict_records_and_purges_only_after_injection(session, monkeypatch, delivered):
+    record, purge = Mock(), Mock()
+    monkeypatch.setattr(server, "_record_inflight_correction", record)
+    monkeypatch.setattr(server, "_drop_queued_duplicates_of_inflight_user", purge)
+    monkeypatch.setattr(server, "_emit", Mock())
+    assert steer()["result"]["status"] == "steered"
+    record.assert_not_called()
+    purge.assert_not_called()
+    callback = session["agent"].steer_strict.call_args.args[1]
+    callback(delivered)
+    assert record.call_count == int(delivered)
+    assert purge.call_count == int(delivered)
+
+
+@pytest.mark.parametrize("state", ["compressing", "idle", "building", "rejected", "exception"])
+def test_strict_failure_never_queues_redirects_or_interrupts(session, monkeypatch, state):
+    agent = session["agent"]
+    setup = {
+        "compressing": lambda: monkeypatch.setattr(server, "_session_compression_in_flight", lambda _: True),
+        "idle": lambda: session.update(running=False),
+        "building": lambda: session.update(agent=None),
+        "rejected": lambda: setattr(agent.steer_strict, "return_value", False),
+        "exception": lambda: setattr(agent.steer_strict, "side_effect", RuntimeError("fixture failure")),
+    }
+    setup[state]()
+    response = steer()
+    assert "error" in response or response["result"]["status"] == "rejected", response
+    assert not session.get("queued_prompt")
+    agent.redirect.assert_not_called()
+    agent.interrupt.assert_not_called()
+    if state in ("compressing", "idle", "building"):
+        agent.steer.assert_not_called()
