+        pending = [(existing, None)] if existing else []
+    drained = getattr(agent, "_drained_steer_entries", [])
+    if drained and "\n".join(text for text, _ in drained) != steer_text:
+        raise ValueError("Steering drain provenance mismatch")
+    agent._pending_steer_entries = pending + (drained or [(steer_text, None)])
+    agent._drained_steer_entries = []
+    agent._pending_steer = f"{existing}\n{steer_text}" if existing else steer_text
+
+
+def _requeue_pending_steer(agent, steer_text: str) -> None:
+    """Keep legacy lock-less test doubles and strict native drains separate."""
+    lock = getattr(agent, "_pending_steer_lock", None)
+    if lock is not None:
+        with lock:
+            # A locked native slot must exist; a malformed agent fails loudly.
+            _restore_locked(agent, steer_text, agent._pending_steer)
+    else:
+        _restore_locked(agent, steer_text, getattr(agent, "_pending_steer", None))
