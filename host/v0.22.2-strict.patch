+"""Strict pre-API delivery must append, never rewrite a historical tool boundary."""
+import copy
+from unittest.mock import Mock
+from typing import Any
+
+from agent.agent_runtime_helpers import apply_pending_steer_to_tool_results
+from agent.interrupt_control import InterruptControlMixin
+from agent.turn_iteration_prep import prepare_iteration
+
+
+def _agent(receipt, mixed=False):
+    agent: Any = InterruptControlMixin()
+    agent.session_id = 'strict-boundary-fixture'
+    agent._skill_nudge_interval = 0
+    agent.run_budget_seconds = 0
+    agent._adopt_nous_key_before_expiry = lambda: None
+    agent._sanitize_tool_call_arguments = lambda *args, **kwargs: 0
+
+    def incoming(*_):
+        if mixed:
+            agent.steer('legacy first')
+        assert agent.steer_strict('fresh guidance', receipt)
+        if mixed:
+            agent.steer('legacy last')
+
+    agent.step_callback = incoming
+    return agent
+
+
+def _tool_round(name):
+    return [
+        {'role': 'assistant', 'tool_calls': [
+            {'id': name, 'type': 'function', 'function': {'name': 'terminal', 'arguments': '{}'}}
+        ]},
+        {'role': 'tool', 'tool_call_id': name, 'content': name + ' result'},
+    ]
+
+
+def test_strict_first_iteration_preserves_the_historical_prefix_until_a_current_tool_boundary():
+    receipt = Mock()
+    agent = _agent(receipt)
+    messages = [{'role': 'user', 'content': 'previous user'}, *_tool_round('previous'),
+                {'role': 'assistant', 'content': 'previous final'},
+                {'role': 'user', 'content': 'fresh user'}]
+    before = copy.deepcopy(messages)
+    result = prepare_iteration(agent, messages=messages, api_call_count=0,
+                               user_message='fresh user', current_turn_user_idx=4)
+    assert result.messages == before, 'Steering rewrote cached history before the fresh user row'
+    receipt.assert_not_called()
+    assert agent._pending_steer == 'fresh guidance'
+    messages.extend(_tool_round('current'))
+    apply_pending_steer_to_tool_results(agent, messages, 1)
+    receipt.assert_called_once_with(True)
+    assert messages[:len(before)] == before
+    assert messages[-1]['display_kind'] == 'steer'
+    assert 'fresh guidance' in messages[-1]['content']
+
+
+def test_mixed_fifo_waits_together_instead_of_sending_legacy_text_past_strict_guidance():
+    receipt = Mock()
+    agent = _agent(receipt, mixed=True)
+    messages = [{'role': 'user', 'content': 'old'}, *_tool_round('old'),
+                {'role': 'assistant', 'content': 'done'}, {'role': 'user', 'content': 'fresh'}]
+    before = copy.deepcopy(messages)
+    prepare_iteration(agent, messages=messages, api_call_count=0,
+                      user_message='fresh', current_turn_user_idx=4)
+    assert messages == before
+    receipt.assert_not_called()
+    messages.extend(_tool_round('new'))
+    apply_pending_steer_to_tool_results(agent, messages, 1)
+    assert 'legacy first\nfresh guidance\nlegacy last' in messages[-1]['content']
+    receipt.assert_called_once_with(True)
+
+
+def test_a_tool_result_at_the_tail_allows_append_only_pre_api_delivery():
+    receipt = Mock()
+    agent = _agent(receipt)
+    messages = [{'role': 'user', 'content': 'current'}, *_tool_round('current')]
+    before = copy.deepcopy(messages)
+    prepare_iteration(agent, messages=messages, api_call_count=1,
+                      user_message='current', current_turn_user_idx=0)
+    assert messages[:len(before)] == before
+    assert len(messages) == len(before) + 1
+    assert messages[-1]['display_kind'] == 'steer'
+    receipt.assert_called_once_with(True)
