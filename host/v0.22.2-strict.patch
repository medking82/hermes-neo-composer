+"""Strict steer receipts acknowledge injection, never a next-turn fallback."""
+from unittest.mock import Mock
+
+from agent.interrupt_control import InterruptControlMixin
+
+
+def test_strict_receipt_waits_for_committed_injection():
+    agent = InterruptControlMixin()
+    receipt = Mock()
+    assert agent.steer_strict('guidance', receipt)
+    receipt.assert_not_called()
+    assert agent._drain_pending_steer() == 'guidance'
+    receipt.assert_not_called()
+    agent.commit_steer_delivery()
+    receipt.assert_called_once_with(True)
+
+
+def test_turn_end_rejects_strict_only_and_preserves_legacy_fifo():
+    agent = InterruptControlMixin()
+    receipt = Mock()
+    agent.steer('legacy first')
+    agent.steer_strict('strict middle', receipt)
+    agent.steer('legacy last')
+    agent.reject_pending_strict_steer()
+    receipt.assert_called_once_with(False)
+    assert agent._drain_pending_steer() == 'legacy first\nlegacy last'
+
+
+def test_finalization_fence_rejects_a_late_call_and_next_turn_drops_old_strict():
+    agent = InterruptControlMixin()
+    receipt = Mock()
+    agent.steer_strict('old turn', receipt)
+    agent.open_strict_steering()
+    receipt.assert_called_once_with(False)
+    assert agent._drain_pending_steer() is None
+    agent.reject_pending_strict_steer()
+    assert agent.steer_strict('too late', Mock()) is False
+    assert agent._drain_pending_steer() is None
+    agent.open_strict_steering()
+    assert agent.steer_strict('new turn', Mock()) is True
+
+
+def test_requeue_keeps_strict_provenance_and_legacy_fifo():
+    from agent.steer_requeue import _requeue_pending_steer
+    agent = InterruptControlMixin()
+    receipt = Mock()
+    agent.steer('first legacy')
+    agent.steer_strict('must not cross turns', receipt)
+    agent.steer('last legacy')
+    drained = agent._drain_pending_steer()
+    assert drained is not None
+    _requeue_pending_steer(agent, drained)
+    agent.reject_pending_strict_steer()
+    receipt.assert_called_once_with(False)
+    assert agent._drain_pending_steer() == 'first legacy\nlast legacy'
+
+
+def test_a_closed_drain_cannot_be_requeued_after_stop():
+    from agent.steer_requeue import _requeue_pending_steer
+    agent = InterruptControlMixin()
+    receipt = Mock()
+    agent.steer_strict('stopped guidance', receipt)
+    drained = agent._drain_pending_steer()
+    assert drained is not None
+    agent.reject_pending_strict_steer()
+    _requeue_pending_steer(agent, drained)
+    receipt.assert_called_once_with(False)
+    assert agent._drain_pending_steer() is None
