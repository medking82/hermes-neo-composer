@@ -0,0 +1,107 @@
+import type { KeyboardEvent } from 'react'
+
+import { isSlashCommandText } from '@/lib/chat-runtime'
+import { behaviorKeyAction } from '@/store/composer-behavior'
+
+interface EnterOptions {
+  busy: boolean
+  disabled: boolean
+  inputDisabled: boolean
+  cardWaiting: boolean
+  queueEdit: boolean
+  readDraft: () => string
+  syncDraft: (text: string) => void
+  steerDraft: (mode: 'steer', blocked: boolean) => unknown
+  queueDraft: () => unknown
+}
+
+function isQueueKey(event: KeyboardEvent, action: string | undefined, options: EnterOptions): boolean {
+  return (
+    event.key === 'Enter' &&
+    !event.shiftKey &&
+    Boolean(
+      event.metaKey ||
+      event.ctrlKey ||
+      (action === 'queue' &&
+        !event.altKey &&
+        !options.cardWaiting &&
+        !options.queueEdit &&
+        !isSlashCommandText(options.readDraft()))
+    )
+  )
+}
+
+/** Arbitration only: the native composer still owns drafts and sending. */
+export function handleBehaviorEnter(event: KeyboardEvent, options: EnterOptions): boolean {
+  const action =
+    event.key === 'Enter' && !event.shiftKey
+      ? behaviorKeyAction({
+          key: event.key,
+          busy: options.busy,
+          ctrlKey: event.ctrlKey,
+          metaKey: event.metaKey,
+          altKey: event.altKey,
+          shiftKey: event.shiftKey
+        })
+      : undefined
+
+  if (action === 'steer') {
+    event.preventDefault()
+
+    if (!options.disabled && !options.inputDisabled && options.busy) {
+      options.syncDraft(options.readDraft())
+      options.steerDraft('steer', options.cardWaiting || options.queueEdit)
+    }
+
+    return true
+  }
+
+  if (!isQueueKey(event, action, options)) {return false}
+  event.preventDefault()
+
+  if (options.busy && !options.disabled) {
+    options.syncDraft(options.readDraft())
+    options.queueDraft()
+  }
+
+  return true
+}
+
+interface GhostOptions {
+  trigger: boolean
+  text: string
+  busy: boolean
+  cardWaiting: boolean
+  hasAttachments: boolean
+  readDraft: () => string
+  decide: (kind: 'consumed' | 'dismissed') => string | null
+  consume: (text: string) => void
+  markConsumed: () => void
+}
+
+export function handleGhostKey(event: KeyboardEvent, options: GhostOptions): boolean {
+  if (
+    options.trigger ||
+    !options.text ||
+    options.busy ||
+    options.cardWaiting ||
+    event.ctrlKey ||
+    event.metaKey ||
+    event.altKey ||
+    event.shiftKey ||
+    options.readDraft().trim() ||
+    options.hasAttachments
+  )
+    {return false}
+
+  if (event.key !== 'Tab' && event.key !== 'Escape') {return false}
+  const accepted = options.decide(event.key === 'Tab' ? 'consumed' : 'dismissed')
+
+  if (!accepted) {return false}
+  event.preventDefault()
+  options.markConsumed()
+
+  if (event.key === 'Tab') {options.consume(accepted)}
+
+  return true
+}
